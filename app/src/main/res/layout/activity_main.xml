<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- 标签条（第一行，毛玻璃半透明） -->
    <LinearLayout
        android:id="@+id/tag_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#F2FFFFFF"
        android:paddingTop="0dp"
        android:paddingBottom="0dp">

        <HorizontalScrollView
            android:id="@+id/tab_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/tab_strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/btn_new_tab"
            android:layout_width="42dp"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="＋"
            android:textSize="15sp"
            android:textColor="#334155"
            android:background="@android:color/transparent"
            android:gravity="center" />

        <!-- ^ 全屏按钮的锚点占位（透明，36dp，与 overlay 按钮同宽） -->
        <View
            android:layout_width="18dp"
            android:layout_height="1dp"
            android:visibility="invisible" />

        <Button
            android:id="@+id/btn_menu"
            android:layout_width="42dp"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="⋮"
            android:textSize="18sp"
            android:textColor="#334155"
            android:background="@android:color/transparent"
            android:gravity="center" />
    </LinearLayout>

    <!-- 地址栏（第二行） -->
    <LinearLayout
        android:id="@+id/addr_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#F5FFFFFF"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="←"
            android:textSize="15sp"
            android:textColor="#334155"
            android:background="@android:color/transparent"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_forward"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="→"
            android:textSize="15sp"
            android:textColor="#334155"
            android:background="@android:color/transparent"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_reload"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="↻"
            android:textSize="15sp"
            android:textColor="#334155"
            android:background="@android:color/transparent"
            android:gravity="center" />

        <EditText
            android:id="@+id/url_bar"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:singleLine="true"
            android:hint="@string/hint_url"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:background="@drawable/url_bar_bg" />

        <Button
            android:id="@+id/btn_bookmark"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="☆"
            android:textSize="16sp"
            android:textColor="#334155"
            android:background="@android:color/transparent"
            android:gravity="center" />
    </LinearLayout>

    <!-- 网页内容容器（多标签的 WebView 都放这里） -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 加载进度条：悬浮于网页内容顶部，仅在加载时可见（GONE 不占位） -->
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:progressTint="#2563EB" />
    </FrameLayout>
    </LinearLayout>

    <!-- 全屏切换按钮（悬浮于标签栏加号和设置之间，浅色半透明） -->
    <Button
        android:id="@+id/btn_fullscreen"
        android:layout_width="18dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="42dp"
        android:text="^"
        android:textSize="16sp"
        android:textColor="#334155"
        android:background="@drawable/fs_btn_bg"
        android:gravity="center" />
</FrameLayout>